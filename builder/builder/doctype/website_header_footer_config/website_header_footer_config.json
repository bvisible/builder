 "fields": [
  {
   "fieldname": "header_tab",
   "fieldtype": "Tab Break",
   "label": "Header"
  },
  {
   "fieldname": "header_section",
   "fieldtype": "Section Break",
   "label": "Header Layout"
  },
  {
   "default": "Logo | Menu Center | Icons",
   "description": "Choose the header layout structure",
   "fieldname": "header_layout",
   "fieldtype": "Select",
   "label": "Layout",
   "options": "Logo | Menu Center | Icons\nLogo | Menu Right | Icons\nMenu Left | Logo Center | Icons",
   "reqd": 1
  },
  {
   "default": "1",
   "description": "Header stays fixed at top when scrolling",
   "fieldname": "sticky_header",
   "fieldtype": "Check",
   "label": "Sticky Header"
  },
  {
   "fieldname": "column_break_header_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "#1a1a1a",
   "description": "Background color of the header",
   "fieldname": "header_bg_color",
   "fieldtype": "Color",
   "label": "Background Color"
  },
  {
   "default": "#ffffff",
   "description": "Text and icon color in header",
   "fieldname": "header_text_color",
   "fieldtype": "Color",
   "label": "Text Color"
  },
  {
   "fieldname": "header_preview_section",
   "fieldtype": "Section Break",
   "label": "Preview",
   "collapsible": 0
  },
  {
   "fieldname": "header_preview",
   "fieldtype": "HTML",
   "options": "<div id=\"header-preview\" style=\"padding: 15px; background: var(--subtle-fg); border-radius: 8px; width: 100%;\"></div>"
  },
  {
   "fieldname": "logo_section",
   "fieldtype": "Section Break",
   "label": "Logo"
  },
  {
   "default": "Image",
   "fieldname": "logo_type",
   "fieldtype": "Select",
   "label": "Logo Type",
   "options": "Text\nImage"
  },
  {
   "depends_on": "eval:doc.logo_type=='Text'",
   "fieldname": "logo_text",
   "fieldtype": "Data",
   "label": "Logo Text"
  },
  {
   "fieldname": "column_break_logo_1",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.logo_type=='Image'",
   "fieldname": "logo_image",
   "fieldtype": "Attach Image",
   "label": "Logo Image"
  },
  {
   "depends_on": "eval:doc.logo_type=='Image' && !doc.logo_image",
   "fieldname": "logo_default_info",
   "fieldtype": "HTML",
   "options": "<div style=\"display: flex; align-items: center; gap: 12px; padding: 10px; background: var(--subtle-fg); border-radius: 8px; margin-top: 8px;\"><img src=\"/files/logo-default.png\" style=\"height: 40px; max-width: 150px; object-fit: contain;\" onerror=\"this.style.display='none'\"><span style=\"color: var(--text-muted); font-size: 12px;\">Default logo will be used. Attach a different image above to override.</span></div>"
  },
  {
   "fieldname": "cta_section",
   "fieldtype": "Section Break",
   "label": "Call to Action Button"
  },
  {
   "default": "1",
   "fieldname": "show_cta",
   "fieldtype": "Check",
   "label": "Show CTA Button"
  },
  {
   "default": "Contact Us",
   "depends_on": "show_cta",
   "fieldname": "cta_text",
   "fieldtype": "Data",
   "label": "CTA Text"
  },
  {
   "fieldname": "column_break_cta_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "/contact",
