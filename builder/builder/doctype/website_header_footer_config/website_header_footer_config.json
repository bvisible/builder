   "fieldname": "search_type",
   "fieldtype": "Select",
   "label": "Search",
   "options": "None\nIcon (overlay)\nSearch Bar (inline)\nSearch Bar (full width bottom)"
  },
  {
   "fieldname": "column_break_icons_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
